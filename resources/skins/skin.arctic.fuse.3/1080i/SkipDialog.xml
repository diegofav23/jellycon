<?xml version="1.0" encoding="UTF-8"?>
<!-- Skip segment button styled for Arctic Fuse 3, based on the skin's own skip marker, shown bottom right -->
<window type="dialog">
    <defaultcontrol always="true">9000</defaultcontrol>
    <zorder>2</zorder>
    <onload>Dialog.Close(fullscreeninfo,true)</onload>

    <include>Animation_FadeIn</include>
    <include>Animation_FadeOut</include>

    <controls>
        <control type="group">
            <right>80</right>
            <bottom>80</bottom>
            <height>70</height>
            <width>420</width>

            <control type="button" id="9000">
                <width>100%</width>
                <height>100%</height>

                <texturefocus border="30" colordiffuse="$VAR[ColorHighlight]">common/dialog.png</texturefocus>
                <texturenofocus border="30" colordiffuse="panel_bg_70">common/dialog.png</texturenofocus>

                <label>[COLOR 00000000]      [/COLOR]$INFO[Window.Property(skip_label)]</label>

                <font>font_main_bold</font>
                <textcolor>panel_fg_90</textcolor>
                <focusedcolor>$VAR[ColorSelected]</focusedcolor>

                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>30</textoffsetx>
            </control>

            <control type="image">
                <left>15</left>
                <centertop>50%</centertop>
                <width>50</width>
                <height>50</height>
                <texture colordiffuse="panel_fg_70">special://skin/extras/icons/forward-step.png</texture>
                <visible>!Control.HasFocus(9000)</visible>
            </control>

            <control type="image">
                <left>15</left>
                <centertop>50%</centertop>
                <width>50</width>
                <height>50</height>
                <texture colordiffuse="$VAR[ColorSelected]">special://skin/extras/icons/forward-step.png</texture>
                <visible>Control.HasFocus(9000)</visible>
            </control>
        </control>
    </controls>
</window>

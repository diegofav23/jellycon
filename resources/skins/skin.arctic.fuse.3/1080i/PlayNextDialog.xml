<?xml version="1.0" encoding="UTF-8"?>
<!-- Next episode panel styled for Arctic Fuse 3, modelled on the skin's Up Next layout -->
<window type="dialog">
    <defaultcontrol always="true">3013</defaultcontrol>
    <zorder>2</zorder>
    <onload>Dialog.Close(fullscreeninfo,true)</onload>

    <include>Animation_FadeIn</include>
    <include>Animation_FadeOut</include>

    <controls>
        <control type="group">
            <right>80</right>
            <bottom>80</bottom>
            <width>900</width>
            <height>290</height>
            <animation type="WindowOpen">
                <effect type="slide" start="0,60" end="0,0" tween="cubic" easing="out" time="400"/>
            </animation>

            <!-- Panel background -->
            <control type="image">
                <texture border="30" colordiffuse="panel_bg_90">common/dialog.png</texture>
            </control>

            <!-- Episode thumb -->
            <control type="group">
                <left>30</left>
                <top>30</top>
                <width>391</width>
                <height>220</height>
                <control type="image">
                    <texture colordiffuse="panel_fg_12" diffuse="diffuse/landscape_w391_h220.png">common/white.png</texture>
                </control>
                <control type="image">
                    <texture background="true" diffuse="diffuse/landscape_w391_h220.png">$INFO[Window.Property(thumb)]</texture>
                    <aspectratio scalediffuse="false">scale</aspectratio>
                </control>
            </control>

            <!-- Labels -->
            <control type="group">
                <left>451</left>
                <top>30</top>
                <right>30</right>

                <control type="label">
                    <top>0</top>
                    <height>36</height>
                    <font>font_tiny</font>
                    <textcolor>$VAR[ColorHighlight]</textcolor>
                    <label>[UPPERCASE]$ADDON[plugin.video.jellycon 30696]$INFO[Window.Property(countdown), · ,s][/UPPERCASE]</label>
                </control>

                <control type="label" id="3011">
                    <top>36</top>
                    <height>50</height>
                    <font>font_main_bold</font>
                    <textcolor>panel_fg_90</textcolor>
                    <label>$INFO[Window.Property(title)]</label>
                </control>

                <control type="label" id="3012">
                    <top>86</top>
                    <height>40</height>
                    <font>font_mini</font>
                    <textcolor>panel_fg_70</textcolor>
                    <label>$INFO[Window.Property(subtitle)]</label>
                </control>

                <!-- Countdown progress, set from python -->
                <control type="progress" id="3015">
                    <visible>!String.IsEqual(Window.Property(mode),credits)</visible>
                    <top>140</top>
                    <height>6</height>
                    <texturebg colordiffuse="panel_fg_12" border="12,0,12,0">progress/progress-nib.png</texturebg>
                    <midtexture colordiffuse="$VAR[ColorHighlight]" border="12,0,12,0">progress/progress-nib.png</midtexture>
                </control>

                <!-- Buttons -->
                <control type="grouplist">
                    <top>170</top>
                    <height>60</height>
                    <orientation>horizontal</orientation>
                    <itemgap>20</itemgap>

                    <control type="button" id="3013">
                        <width>auto</width>
                        <minwidth>190</minwidth>
                        <height>60</height>
                        <texturefocus border="30" colordiffuse="$VAR[ColorHighlight]">common/dialog.png</texturefocus>
                        <texturenofocus border="30" colordiffuse="panel_fg_12">common/dialog.png</texturenofocus>
                        <label>$ADDON[plugin.video.jellycon 30697]</label>
                        <font>font_mini_bold</font>
                        <textcolor>panel_fg_90</textcolor>
                        <focusedcolor>$VAR[ColorSelected]</focusedcolor>
                        <align>center</align>
                        <aligny>center</aligny>
                        <textoffsetx>30</textoffsetx>
                    </control>

                    <control type="button" id="3014">
                        <width>auto</width>
                        <minwidth>190</minwidth>
                        <height>60</height>
                        <texturefocus border="30" colordiffuse="$VAR[ColorHighlight]">common/dialog.png</texturefocus>
                        <texturenofocus border="30" colordiffuse="panel_fg_12">common/dialog.png</texturenofocus>
                        <label>$LOCALIZE[15067]</label>
                        <font>font_mini_bold</font>
                        <textcolor>panel_fg_90</textcolor>
                        <focusedcolor>$VAR[ColorSelected]</focusedcolor>
                        <align>center</align>
                        <aligny>center</aligny>
                        <textoffsetx>30</textoffsetx>
                    </control>
                </control>
            </control>
        </control>
    </controls>
</window>
